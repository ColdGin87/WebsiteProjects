# Local file database (created automatically). On Vercel use Turso instead.
TURSO_DATABASE_URL=file:./data/goldendale.db
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Required in production. Generate a long random string.
JWT_SECRET=change-this-to-a-random-secret-string

# Used to build magic-link, reset, join, and public leaderboard URLs.
APP_BASE_URL=http://localhost:3000

# Optional later: NEXT_PUBLIC_SUPABASE_URL=
# Optional later: NEXT_PUBLIC_SUPABASE_ANON_KEY=
